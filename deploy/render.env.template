# =====================================================================
# Template env backend Laravel untuk Render (branch integrasi-auth)
# ---------------------------------------------------------------------
# - File ini HANYA berisi placeholder <...>. Aman di-commit.
# - Salin ke Notepad / file DI LUAR folder repo, isi nilainya di sana,
#   lalu tempel ke Render: Environment -> Add from .env.
# - JANGAN commit / tempel ke chat setelah diisi.
# - JANGAN isi PORT (Render mengisinya sendiri).
# =====================================================================

# --- Aplikasi -------------------------------------------------------
APP_NAME=Digital.in
# staging = pembayaran mock jalan (uang tiruan). production = pembayaran error 500 (belum ada gateway asli).
APP_ENV=staging
# Hasil: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"   (BARU, jangan pakai kunci laptop)
APP_KEY=<base64-kunci-baru-32-byte>
APP_DEBUG=false
# URL service Render, mis. https://digitalin-api.onrender.com (tanpa / di akhir)
APP_URL=https://<nama-service>.onrender.com
APP_BUSINESS_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Frontend & proxy -------------------------------------------------
# Domain Vercel persis, tanpa / di akhir. Isi sementara, perbarui setelah Vercel jadi.
FRONTEND_URL=https://<domain-vercel>.vercel.app
CORS_ALLOWED_ORIGINS=https://<domain-vercel>.vercel.app
# Render ada di belakang load balancer: wajib agar rate limit OTP membaca IP asli.
TRUSTED_PROXIES=*

# --- Database (Neon, branch production, koneksi LANGSUNG / bukan -pooler) ---
DB_CONNECTION=pgsql
# postgresql://<user>:<password>@<ep-xxx>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
DB_URL=postgresql://<user>:<password>@<ep-xxx>.ap-southeast-1.aws.neon.tech/<database>?sslmode=require

# --- Cache, session, queue, broadcast ----------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
# Jangan "log": isi chat akan tertulis di log.
BROADCAST_CONNECTION=null

# --- File privat (Supabase Storage, S3-compatible) ---------------------
KTM_FILES_DISK=s3
SUBMISSION_FILES_DISK=s3
AWS_ACCESS_KEY_ID=<access-key-supabase>
AWS_SECRET_ACCESS_KEY=<secret-key-supabase>
# Salin persis dari Supabase -> Project Settings -> Storage -> S3 Connection
AWS_DEFAULT_REGION=<region-supabase>
AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_BUCKET=digitalin-private
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Email ----------------------------------------------------------------
# Render FREE memblokir port SMTP 25, 465, 587 -> Gmail SMTP tidak bisa dipakai dari Render Free.
# Pakai penyedia SMTP yang mendukung port 2525, mis. Brevo (gratis 300 email/hari):
#   Brevo -> SMTP & API -> SMTP: login = MAIL_USERNAME, SMTP key = MAIL_PASSWORD.
#   Alamat pengirim (MAIL_FROM_ADDRESS) wajib diverifikasi di Brevo -> Senders.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
# Kosongkan MAIL_SCHEME untuk 2525 (STARTTLS otomatis): jangan tambahkan baris MAIL_SCHEME.
MAIL_USERNAME=<login-smtp-brevo>
MAIL_PASSWORD=<smtp-key-brevo>
MAIL_FROM_ADDRESS=<alamat-pengirim-terverifikasi>
MAIL_FROM_NAME=Digital.in
# Instance berbayar (Starter): Gmail boleh dipakai: smtp.gmail.com, port 465, MAIL_SCHEME=smtps, App Password.

# --- Pembayaran & pencairan (mock) ---------------------------------------
PAYMENT_GATEWAY_DRIVER=mock
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
PAYMENT_WEBHOOK_SECRET=<random-64-hex-baru>
DISBURSEMENT_DRIVER=mock
# Jalankan perintah yang sama sekali lagi: HARUS berbeda dari PAYMENT_WEBHOOK_SECRET
DISBURSEMENT_WEBHOOK_SECRET=<random-64-hex-baru-berbeda>

# --- WhatsApp (opsional) ---------------------------------------------------
# Belum punya kredensial Meta? Jangan tambahkan baris WHATSAPP_* sama sekali.
# OTP lewat WhatsApp akan gagal "layanan tidak tersedia"; OTP email tetap jalan.
# WHATSAPP_ACCESS_TOKEN=<token-meta>
# WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
# WHATSAPP_OTP_TEMPLATE=<nama-template>
# WHATSAPP_TEMPLATE_LANGUAGE=id
# WHATSAPP_API_VERSION=<mis. v21.0>
